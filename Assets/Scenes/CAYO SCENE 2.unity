  m_Script: {fileID: 11500000, guid: 0fe71ecd898f3a34d845a47968d3edb2, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  defaultAnchor: {fileID: 228924420}
  closeAnchor: {fileID: 132429004}
  moveDuration: 0.6
  dialogues:
  - id: start_level
    lines:
    - text: '[Sistema: nucleo de proyeccion encontrado. Energia entrando...]'
      voiceClip: {fileID: 8300000, guid: 8b80494db16032a4d80ffe6536d9ef98, type: 3}
      autoAdvanceAfter: 2
    - text: Ok... No entiendo que hacemos ambos aqui
      voiceClip: {fileID: 8300000, guid: 81948bf3887d0954dabeba5ffc8c0914, type: 3}
      autoAdvanceAfter: 1
    - text: No tengo ruedas. Asi que me anclo a ti, no es opcional.
      voiceClip: {fileID: 8300000, guid: d85994e0abb7fad4b8a815c1edc1d6bd, type: 3}
      autoAdvanceAfter: 2
    closeWhenDone: 1
  - id: tuto_levitar
    lines:
    - text: Puedo hacer que levites algunos objetos...
      voiceClip: {fileID: 8300000, guid: 8b80494db16032a4d80ffe6536d9ef98, type: 3}
      autoAdvanceAfter: 2
    - text: Nada pesado, no me pidas milagros.
      voiceClip: {fileID: 8300000, guid: 0ec89e4a9dc8031428e05ee845eba86c, type: 3}
      autoAdvanceAfter: 2
    - text: Quizas te ayude a abrirte paso donde quieras que vayamos.
      voiceClip: {fileID: 8300000, guid: 81948bf3887d0954dabeba5ffc8c0914, type: 3}
      autoAdvanceAfter: 2
    closeWhenDone: 1
  - id: palancas
    lines:
    - text: Parece que falta corriente para accionar las palancas
      voiceClip: {fileID: 8300000, guid: 0ec89e4a9dc8031428e05ee845eba86c, type: 3}
      autoAdvanceAfter: 2
    closeWhenDone: 1
  - id: tuto_proyector
    lines:
    - text: No creo que puedas hacer ese salto...
      voiceClip: {fileID: 8300000, guid: 0ec89e4a9dc8031428e05ee845eba86c, type: 3}
      autoAdvanceAfter: 2
    - text: Puedo recrear proyecciones de objetos destruidos. Intenta recrear esa
        caja, y ve si puedes llegar al otro lado...
      voiceClip: {fileID: 8300000, guid: 81948bf3887d0954dabeba5ffc8c0914, type: 3}
      autoAdvanceAfter: 4
    closeWhenDone: 1
  - id: scavengers_intro
    lines:
    - text: Scavangers... robots creados para poder ayudar en el funcionamiento de
        la fabrica
      voiceClip: {fileID: 8300000, guid: 8b80494db16032a4d80ffe6536d9ef98, type: 3}
      autoAdvanceAfter: 4
    - text: o eso era lo que hacian antes de que todo colapse
      voiceClip: {fileID: 8300000, guid: 81948bf3887d0954dabeba5ffc8c0914, type: 3}
      autoAdvanceAfter: 3
    - text: Ahora buscan actualizarse robando piezas de otros robots
      voiceClip: {fileID: 8300000, guid: e14c32b40b2d5884a9456dbc1cf893b7, type: 3}
      autoAdvanceAfter: 2
    - text: Asi que...
      voiceClip: {fileID: 8300000, guid: 0ec89e4a9dc8031428e05ee845eba86c, type: 3}
      autoAdvanceAfter: 1
    - text: Evitalos a toda costa
      voiceClip: {fileID: 8300000, guid: 81948bf3887d0954dabeba5ffc8c0914, type: 3}
      autoAdvanceAfter: 2
    closeWhenDone: 1
  - id: tuto_eco
    lines:
    - text: El scavanger... quizas sepa de algo que nos pueda ayudar aqui
      voiceClip: {fileID: 8300000, guid: e14c32b40b2d5884a9456dbc1cf893b7, type: 3}
      autoAdvanceAfter: 2
    - text: Puedo mostrar hologramas de un tiempo pasado, lo llamo ecos de memoria
      voiceClip: {fileID: 8300000, guid: 8b80494db16032a4d80ffe6536d9ef98, type: 3}
      autoAdvanceAfter: 2
    - text: Te dara pistas de como resolver esta situacion
      voiceClip: {fileID: 8300000, guid: 0ec89e4a9dc8031428e05ee845eba86c, type: 3}
      autoAdvanceAfter: 2
    closeWhenDone: 1
  - id: cargador
    lines:
    - text: Parece ser una estacion de carga...
      voiceClip: {fileID: 8300000, guid: d85994e0abb7fad4b8a815c1edc1d6bd, type: 3}
      autoAdvanceAfter: 2
    closeWhenDone: 1
  - id: elevador
    lines:
    - text: El elevador no funciona, le falta energia.
      voiceClip: {fileID: 8300000, guid: 0ec89e4a9dc8031428e05ee845eba86c, type: 3}
      autoAdvanceAfter: 2
    closeWhenDone: 1
  - id: radar
    lines:
    - text: Perdon por no mencionarlo antes...
      voiceClip: {fileID: 8300000, guid: 8b80494db16032a4d80ffe6536d9ef98, type: 3}
      autoAdvanceAfter: 2
    - text: Pero revisando el sistema note que contamos con un radar
      voiceClip: {fileID: 8300000, guid: 0ec89e4a9dc8031428e05ee845eba86c, type: 3}
      autoAdvanceAfter: 2
    - text: Podrias usarlo para detectar objetos interesantes...
      voiceClip: {fileID: 8300000, guid: d85994e0abb7fad4b8a815c1edc1d6bd, type: 3}
      autoAdvanceAfter: 2
    closeWhenDone: 1
  - id: start_level2
    lines:
    - text: Vaya... es raro que la fabrica conecte con un subterraneo
      voiceClip: {fileID: 8300000, guid: 8b80494db16032a4d80ffe6536d9ef98, type: 3}
      autoAdvanceAfter: 3
    - text: Exploremos para ver como salir de aqui
      voiceClip: {fileID: 8300000, guid: 81948bf3887d0954dabeba5ffc8c0914, type: 3}
      autoAdvanceAfter: 2
    closeWhenDone: 1
  - id: cables
    lines:
    - text: Exploremos para ver como salir de aqui
      voiceClip: {fileID: 8300000, guid: 81948bf3887d0954dabeba5ffc8c0914, type: 3}
      autoAdvanceAfter: 2
    closeWhenDone: 1
  - id: mapa
    lines:
    - text: Parece una ruta segura a traves de las vias... pero esta incompleto...
      voiceClip: {fileID: 8300000, guid: 0ec89e4a9dc8031428e05ee845eba86c, type: 3}
      autoAdvanceAfter: 3
    - text: Creo que hay algo escrito detras
      voiceClip: {fileID: 8300000, guid: d85994e0abb7fad4b8a815c1edc1d6bd, type: 3}
      autoAdvanceAfter: 2
    closeWhenDone: 1
  - id: screamer
    lines:
    - text: QUE FUE ESO!? Estas seguro de seguir por ahi...?
      voiceClip: {fileID: 8300000, guid: 8b80494db16032a4d80ffe6536d9ef98, type: 3}
      autoAdvanceAfter: 3
    closeWhenDone: 1
  - id: central
    lines:
    - text: Desde aqui se le da energia a las vias para que el tren levite
      voiceClip: {fileID: 8300000, guid: e14c32b40b2d5884a9456dbc1cf893b7, type: 3}
      autoAdvanceAfter: 3
    - text: Si vas a reparar eso date prisa, sigo nervioso por lo de antes...
      voiceClip: {fileID: 8300000, guid: d85994e0abb7fad4b8a815c1edc1d6bd, type: 3}
      autoAdvanceAfter: 3
    closeWhenDone: 1
  - id: fusibles
    lines:
    - text: Desde aqui se le da energia a las vias para que el tren levite
      voiceClip: {fileID: 8300000, guid: e14c32b40b2d5884a9456dbc1cf893b7, type: 3}
      autoAdvanceAfter: 3
    - text: Si vas a reparar eso date prisa, sigo nervioso por lo de antes...
      voiceClip: {fileID: 8300000, guid: d85994e0abb7fad4b8a815c1edc1d6bd, type: 3}
      autoAdvanceAfter: 3
    closeWhenDone: 1
  skipKey: 101
  globalCharDelay: 0.02
  showAtStart: 0
  lockPlayerDuringDialogue: 1
